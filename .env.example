# External Neon PostgreSQL connection used by the API and Drizzle migrations.
# In Webdev, configure this as the protected secret NEON_DATABASE_URL.
NEON_DATABASE_URL=

# PostgreSQL connection fallback for local development.
DATABASE_URL=

# Optional direct Neon connection for schema migrations; NEON_DATABASE_URL is used
# when this is empty.
MIGRATION_DATABASE_URL=

# Number of trusted reverse-proxy hops; leave empty for the environment default.
TRUST_PROXY_HOPS=

# External Clerk instance. Never expose the secret key through a VITE_ variable.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Optional Clerk frontend API proxy URL for production.
VITE_CLERK_PROXY_URL=

# Existing general AI model and key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional soil-photo-only overrides; blank values fall back to OPENAI_API_KEY/provider.
PLANT_ADVISOR_API_KEY=
PLANT_ADVISOR_BASE_URL=
PLANT_ADVISOR_MODEL=gpt-6-luna

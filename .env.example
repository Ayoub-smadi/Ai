# PostgreSQL connection used by the API.
DATABASE_URL=

# Optional direct Neon connection for schema migrations; DATABASE_URL is used
# when this is empty.
MIGRATION_DATABASE_URL=

# External Clerk instance. Never expose the secret key through a VITE_ variable.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Optional Clerk frontend API proxy URL for production.
VITE_CLERK_PROXY_URL=

# Required for real AI test responses; the API returns an explicit error without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

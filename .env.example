# Neon PostgreSQL connection; configure as a protected server secret in WebDev.
DATABASE_URL=

# Required to grant the designated Manus OAuth identity administrator access.
# Configure as a protected server secret; never expose to browser code.
ADMIN_EMAIL=

# Optional: needed only for live OpenAI-backed AI-agent test responses.
# Keep server-only; never expose this as a VITE_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
